<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- keepScreenOn: the visuals are watched, not touched, so the screen would otherwise time
         out mid-song. It only applies while this window is showing. -->

    <FrameLayout
        android:id="@+id/surfaceContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout android:id="@+id/receiverPanel" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@android:color/black"
        android:visibility="gone">
        <SurfaceView android:id="@+id/receiverVideo" android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <TextView android:id="@+id/receiverWaiting" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:padding="32dp" android:textSize="20sp"
            android:textColor="@color/overlay_content" android:text="@string/cast_receiving" />
    </FrameLayout>

    <!-- The renderer keeps running beneath this View; its framebuffer alone goes to the TV. -->
    <LinearLayout
        android:id="@+id/castStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/cast_you_are_casting" android:textColor="@color/overlay_content_secondary"
            android:textSize="18sp" android:gravity="center" />
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/castDeviceName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="@color/overlay_content" android:textSize="28sp" android:gravity="center"
            android:maxLines="2" android:ellipsize="end"
            app:autoSizeTextType="uniform" app:autoSizeMinTextSize="14sp"
            app:autoSizeMaxTextSize="28sp" app:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/castControlMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:maxWidth="440dp" android:gravity="center"
            android:text="@string/cast_control_message" android:textColor="@color/overlay_content_secondary"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnCast"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/cast_button_background"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone"
        android:contentDescription="@string/cast_start">
        <ImageView android:id="@+id/castButtonIcon" android:layout_width="24dp"
            android:layout_height="24dp" android:importantForAccessibility="no"
            app:srcCompat="@drawable/ic_cast" />
        <TextView android:id="@+id/castButtonText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="@string/cast_start" android:textColor="@color/overlay_content"
            android:textSize="16sp" android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Plain shadowed text rather than a badge or panel, so it doesn't box off part of the visual.
         Shows the current preset's name, or a status message while presets load. -->
    <TextView
        android:id="@+id/presetStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/presets_loading"
        android:textColor="@color/overlay_content"
        android:textSize="15sp"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:shadowDy="1"
        android:visibility="gone" />

    <!-- Portrait: preset controls above the media keys. Landscape (set in code, since rotation
         doesn't recreate the activity): one row, preset controls | media keys. -->
    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/overlay_bar"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/presetControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrevious"
                style="@style/ControlButton"
                app:drawableTopCompat="@drawable/ic_preset_previous"
                android:text="@string/btn_previous" />

            <TextView
                android:id="@+id/btnNext"
                style="@style/ControlButton"
                app:drawableTopCompat="@drawable/ic_preset_next"
                android:text="@string/btn_next" />

            <TextView
                android:id="@+id/btnShuffle"
                style="@style/ControlButton"
                android:background="@drawable/shuffle_button_background"
                app:drawableTopCompat="@drawable/ic_shuffle"
                android:text="@string/btn_shuffle"
                android:textColor="@color/toggle_content"
                app:drawableTint="@color/toggle_content" />

            <!-- Filled heart (activated) when the playing preset is a favourite. -->
            <TextView
                android:id="@+id/btnFavourite"
                style="@style/ControlButton"
                app:drawableTopCompat="@drawable/ic_favourite"
                android:text="@string/btn_favourite" />

            <TextView
                android:id="@+id/btnPlaylist"
                style="@style/ControlButton"
                app:drawableTopCompat="@drawable/ic_preset_list"
                android:text="@string/btn_playlist" />

            <TextView
                android:id="@+id/btnSettings"
                style="@style/ControlButton"
                app:drawableTopCompat="@drawable/ic_settings"
                android:text="@string/btn_settings" />

        </LinearLayout>

        <View
            android:id="@+id/controlDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="@color/overlay_divider" />

        <LinearLayout
            android:id="@+id/mediaControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnMediaPrevious"
                style="@style/MediaButton"
                android:src="@drawable/ic_media_previous"
                android:contentDescription="@string/media_previous" />

            <ImageButton
                android:id="@+id/btnMediaPlayPause"
                style="@style/MediaButton"
                android:src="@drawable/ic_media_play_pause"
                android:contentDescription="@string/media_play_pause" />

            <ImageButton
                android:id="@+id/btnMediaNext"
                style="@style/MediaButton"
                android:src="@drawable/ic_media_next"
                android:contentDescription="@string/media_next" />

        </LinearLayout>

    </LinearLayout>

    <!-- Every option visible at once; replaces the old tap-to-cycle buttons. -->
    <LinearLayout
        android:id="@+id/settingsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/settings_sheet_background"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textColor="@color/overlay_content"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnCloseSettings"
                android:nextFocusDown="@id/switchAutoAdvance"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                app:tint="@color/overlay_content"
                android:background="@drawable/remote_focus_background"
                android:contentDescription="@string/settings_close" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/settingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoAdvance"
                    android:nextFocusUp="@id/btnCloseSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/setting_auto_advance"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBeatCuts"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/setting_beat_cuts"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPresetNameDuringTransitions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/setting_preset_name_transitions"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchScreenDependentRendering"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/setting_screen_dependent_rendering"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/spinnerPresetDuration"
                    android:text="@string/setting_preset_duration" />

                <Spinner
                    android:id="@+id/spinnerPresetDuration"
                    style="@style/TimingSpinner"
                    android:contentDescription="@string/setting_preset_duration" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/spinnerAdditionalRandom"
                    android:text="@string/setting_additional_random" />

                <Spinner
                    android:id="@+id/spinnerAdditionalRandom"
                    style="@style/TimingSpinner"
                    android:contentDescription="@string/setting_additional_random" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/spinnerTransitionTime"
                    android:text="@string/setting_transition_time" />

                <Spinner
                    android:id="@+id/spinnerTransitionTime"
                    style="@style/TimingSpinner"
                    android:contentDescription="@string/setting_transition_time" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/transition_random_description"
                    android:textColor="@color/overlay_content_secondary" android:textSize="13sp" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/spinnerFrameRate"
                    android:text="@string/setting_frame_rate" />

                <Spinner android:id="@+id/spinnerFrameRate" style="@style/TimingSpinner"
                    android:contentDescription="@string/setting_frame_rate" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/frame_rate_description" android:textSize="13sp"
                    android:textColor="@color/overlay_content_secondary" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/sliderMeshSizeX"
                    android:text="@string/setting_mesh_size" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="@string/mesh_size_x"
                        android:textColor="@color/overlay_content_secondary"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/sliderMeshSizeX"
                        android:contentDescription="@string/mesh_size_x_accessibility"
                        android:focusable="true"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="300"
                        android:min="8"
                        android:progress="32" />

                    <EditText
                        android:id="@+id/inputMeshSizeX"
                        android:contentDescription="@string/mesh_size_x_accessibility"
                        android:singleLine="true"
                        android:layout_width="64dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:selectAllOnFocus="true"
                        android:text="32"
                        android:textColor="@color/overlay_content"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:text="@string/mesh_size_y"
                        android:textColor="@color/overlay_content_secondary"
                        android:textSize="16sp" />

                    <SeekBar
                        android:id="@+id/sliderMeshSizeY"
                        android:contentDescription="@string/mesh_size_y_accessibility"
                        android:focusable="true"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:max="300"
                        android:min="8"
                        android:progress="24" />

                    <EditText
                        android:id="@+id/inputMeshSizeY"
                        android:contentDescription="@string/mesh_size_y_accessibility"
                        android:singleLine="true"
                        android:layout_width="64dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:selectAllOnFocus="true"
                        android:text="24"
                        android:textColor="@color/overlay_content"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mesh_size_description"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/spinnerQuality"
                    android:text="@string/setting_quality" />

                <Spinner
                    android:id="@+id/spinnerQuality"
                    style="@style/TimingSpinner"
                    android:contentDescription="@string/setting_quality" />

                <TextView
                    android:id="@+id/qualityDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <TextView
                    style="@style/SettingLabel"
                    android:labelFor="@id/groupAudioSource"
                    android:text="@string/setting_audio_source" />

                <RadioGroup
                    android:id="@+id/groupAudioSource"
                    style="@style/SegmentedGroup">

                    <RadioButton
                        android:id="@+id/audioSourceAutomatic"
                        style="@style/Segment"
                        android:text="@string/audio_source_automatic" />

                    <RadioButton
                        android:id="@+id/audioSourceMic"
                        style="@style/Segment"
                        android:text="@string/audio_source_mic" />

                    <RadioButton
                        android:id="@+id/audioSourceInternal"
                        style="@style/Segment"
                        android:text="@string/audio_source_internal" />

                </RadioGroup>

                <TextView
                    android:id="@+id/audioSourceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchStereoInternalAudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/setting_stereo_internal_audio"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/stereo_internal_audio_description"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSwipeGestures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/setting_swipe_gestures"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/audioSensitivityLabel"
                    style="@style/SettingLabel"
                    android:labelFor="@id/sliderAudioSensitivity"
                    android:text="@string/setting_audio_sensitivity" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <SeekBar
                        android:id="@+id/sliderAudioSensitivity"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:max="250" />
                    <Button
                        android:id="@+id/resetAudioSensitivity"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/reset_audio_sensitivity"
                        android:contentDescription="@string/reset_audio_sensitivity_description" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/audio_sensitivity_description"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/fftShaderScalingLabel"
                    style="@style/SettingLabel"
                    android:labelFor="@id/sliderFftShaderScaling"
                    android:text="@string/setting_fft_shader_scaling" />

                <SeekBar
                    android:id="@+id/sliderFftShaderScaling"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="200" />

                <TextView
                    android:id="@+id/fftShaderNoiseFloorLabel"
                    style="@style/SettingLabel"
                    android:labelFor="@id/sliderFftShaderNoiseFloor"
                    android:text="@string/setting_fft_shader_noise_floor" />

                <SeekBar
                    android:id="@+id/sliderFftShaderNoiseFloor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/btnWirelessDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="@drawable/remote_focus_background"
                    android:text="@string/cast_wireless_settings"
                    android:textColor="@color/overlay_content"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/wirelessDisplayDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/cast_wireless_description"
                    android:textColor="@color/overlay_content_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/engineInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:orientation="vertical"
                    android:focusable="true"
                    android:background="@drawable/remote_focus_background">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/engine_info_title"
                        android:textColor="@color/overlay_content"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/engineLiveInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/overlay_content"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/engine_patch_info"
                        android:textColor="@color/overlay_content_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/engineUpstreamInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="monospace"
                        android:breakStrategy="simple"
                        android:textColor="@color/overlay_content_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/engine_snapshot_description"
                        android:textColor="@color/overlay_content_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/playlistPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/overlay_sheet"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <EditText
                android:id="@+id/playlistSearch"
                android:nextFocusRight="@id/btnFavouritesOnly"
                android:nextFocusDown="@id/playlistRecyclerView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:hint="@string/playlist_search_hint" />

            <!-- Shows only favourites when activated. -->
            <TextView
                android:id="@+id/btnFavouritesOnly"
                android:nextFocusLeft="@id/playlistSearch"
                android:nextFocusRight="@id/btnClosePlaylist"
                android:nextFocusDown="@id/playlistRecyclerView"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:drawablePadding="6dp"
                android:text="@string/playlist_favourites_only"
                android:textSize="14sp"
                android:textColor="@color/toggle_content"
                app:drawableStartCompat="@drawable/ic_favourite"
                app:drawableTint="@color/toggle_content"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/remote_focus_background" />

            <Button
                android:id="@+id/btnClosePlaylist"
                android:nextFocusLeft="@id/btnFavouritesOnly"
                android:nextFocusDown="@id/playlistRecyclerView"
                style="?android:attr/buttonStyleSmall"
                android:background="@drawable/remote_focus_background"
                android:textColor="@color/overlay_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_close" />

        </LinearLayout>

        <TextView
            android:id="@+id/playlistResultsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/overlay_content"
            android:textSize="16sp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playlistRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
