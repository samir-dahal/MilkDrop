<resources>
    <style name="TimingSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:focusable">true</item>
        <item name="android:popupBackground">@color/overlay_sheet</item>
    </style>
    <!-- Preset controls: icon over a short label. -->
    <style name="ControlButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/control_min_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">@dimen/control_text_size</item>
        <item name="android:textColor">@color/overlay_content</item>
        <item name="drawableTint">@color/overlay_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/remote_focus_background</item>
    </style>

    <!-- Media player keys: icon only, a step smaller and dimmer than the preset controls. -->
    <style name="MediaButton">
        <item name="android:focusable">true</item>
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/overlay_content_secondary</item>
        <item name="android:background">@drawable/remote_focus_background</item>
    </style>

    <!-- Favourite / hide toggles on preset List rows: full white when on, dimmed when off. -->
    <style name="RowToggleButton">
        <item name="android:focusable">true</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/toggle_content</item>
        <item name="android:background">@drawable/remote_focus_background</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">@dimen/setting_label_size</item>
        <item name="android:textColor">@color/overlay_content_secondary</item>
    </style>

    <style name="SegmentedGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">3dp</item>
        <item name="android:background">@drawable/segmented_group_background</item>
    </style>

    <style name="Segment">
        <item name="android:focusable">true</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/segment_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/segment_text_size</item>
        <item name="android:textColor">@color/segment_content</item>
        <item name="android:background">@drawable/segment_background</item>
    </style>

    <!-- Long quality labels remain readable on phones, tablets, and TV displays. -->
    <style name="QualitySegment" parent="Segment">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_weight">0</item>
    </style>
</resources>
